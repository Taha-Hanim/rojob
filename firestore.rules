rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() && request.auth.token.email in [
        'ceo@rojob.eu'
      ];
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function stockDecrementOnly() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(["stock", "stockBySize"])
        && request.resource.data.stock is number
        && request.resource.data.stock >= 0
        && (
          !(resource.data.keys().hasAny(["stock"]))
          || request.resource.data.stock <= resource.data.stock
        );
    }

    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
      // Paid checkout runs as the customer, so they may lower stock but never raise it.
      allow update: if isAdmin() || stockDecrementOnly();
    }
    match /portfolio/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /journal/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /orders/{id} {
      allow create: if true;
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid)
        || (signedIn() && resource.data.customer.email == request.auth.token.email);
      allow update, delete: if isAdmin();
    }
    match /stockMoves/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    match /salesLedger/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    match /newsletter/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    match /inquiries/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    match /users/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }
  }
}
