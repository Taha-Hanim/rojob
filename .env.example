# Firebase (Project settings → Your apps → Web SDK)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Cloudinary (Settings → Upload → unsigned preset)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Site mode: prelaunch | commerce
VITE_SITE_MODE=commerce

# Storefront currency
VITE_CURRENCY=PLN

# Stripe publishable key (pk_test_... or pk_live_...)
VITE_STRIPE_PUBLISHABLE_KEY=

# Contact form → EmailJS (sends to contact@rojob.eu)
VITE_CONTACT_EMAIL=contact@rojob.eu
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_CONTACT_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_ORDER_NOTIFY_EMAIL=ceo@rojob.eu
VITE_SITE_URL=https://www.rojob.eu
VITE_ADMIN_EMAILS=ceo@rojob.eu

# --- Cloudflare Pages Functions / Vercel only (NOT VITE_ — never expose in frontend) ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# SITE_URL=https://rojob.eu
